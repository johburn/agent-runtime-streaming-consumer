# Google Cloud Project Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_LOCATION=us-central1

# Reasoning Engine / Agent Runtime ID
# Format: projects/{PROJECT_NUMBER}/locations/{LOCATION}/reasoningEngines/{ENGINE_ID}
GCP_REASONING_ENGINE_ID=projects/123456789012/locations/us-central1/reasoningEngines/1234567890123456789

# Client Backend Mode: 'api' (Direct REST :streamQuery URL) or 'sdk' (Vertex AI SDK)
CLIENT_MODE=api

# Streaming Mode (Configured to SSE - Server-Sent Events as per ADK RunConfig)
STREAMING_MODE=sse

# Payload Format sent to AdkApp:
PAYLOAD_FORMAT=standard

# Agent User & Session Identifiers
AGENT_USER_ID=user-123
# AGENT_SESSION_ID=  # Dejar vacío para generar un UUID aleatorio por sesión

# Authentication
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GCP_ACCESS_TOKEN=ya29.your_token_here

HTTP_TIMEOUT_SECONDS=180.0
